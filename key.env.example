# Salin menjadi key.env (key.env tidak pernah di-commit, lihat .gitignore)
# API key YouTube Data API v3 dari Google Cloud Console. YT_API_KEY juga diterima.
YOUTUBE_API_KEY=isi_api_key_anda
# Salt rahasia untuk HMAC-SHA256 ID kanal penulis. Pakai string acak panjang dan
# simpan baik-baik: salt yang sama diperlukan agar hash penulis konsisten antar-run.
AUTHOR_HASH_SALT=isi_string_acak_panjang
